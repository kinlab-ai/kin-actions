{
  "schema": 2,
  "protocol": {
    "minimum_version": "0.1.34",
    "pilot_repository": "kinlab-ai/kin-blobs",
    "pin_branch": "automation/kin-actions-pin-next",
    "required_check_app_id": 15368,
    "main_workflow": "registry-publish.yml"
  },
  "rollout": [
    {
      "id": "pilot",
      "repositories": [
        "kinlab-ai/kin-blobs"
      ]
    },
    {
      "id": "primitives",
      "repositories": [
        "kinlab-ai/kin-search",
        "kinlab-ai/kin-vector",
        "kinlab-ai/kin-infer"
      ]
    },
    {
      "id": "model",
      "repositories": [
        "kinlab-ai/kin-model"
      ]
    },
    {
      "id": "database",
      "repositories": [
        "kinlab-ai/kin-db"
      ]
    },
    {
      "id": "surfaces",
      "repositories": [
        "kinlab-ai/kin-vfs",
        "kinlab-ai/kin-lsp"
      ]
    },
    {
      "id": "other-consumers",
      "repositories": [
        "kinlab-ai/kin",
        "kinlab-ai/kin-bench",
        "kinlab-ai/kinlab",
        "kinlab-ai/kin-bench-spec",
        "kinlab-ai/kin-editor",
        "kinlab-ai/kin-infra",
        "kinlab-ai/homebrew-kin"
      ]
    }
  ],
  "repositories": {
    "kinlab-ai/kin": {
      "kind": "other",
      "workflow_paths": [
        ".github/workflows/approve-to-merge.yml",
        ".github/workflows/merge-queue-ejection-notice.yml",
        ".github/workflows/notify-approver.yml"
      ]
    },
    "kinlab-ai/kin-bench": {
      "kind": "other",
      "workflow_paths": [
        ".github/workflows/approve-to-merge.yml",
        ".github/workflows/kin-dependency-wave.yml",
        ".github/workflows/merge-queue-ejection-notice.yml",
        ".github/workflows/notify-approver.yml"
      ]
    },
    "kinlab-ai/kinlab": {
      "kind": "other",
      "workflow_paths": [
        ".github/workflows/ci.yml",
        ".github/workflows/merge-queue-ejection-notice.yml",
        ".github/workflows/notify-approver.yml"
      ]
    },
    "kinlab-ai/kin-blobs": {
      "kind": "cargo_release",
      "workflow_paths": [
        ".github/workflows/registry-publish.yml",
        ".github/workflows/scheduled-failure-alarm.yml"
      ]
    },
    "kinlab-ai/kin-search": {
      "kind": "cargo_release",
      "workflow_paths": [
        ".github/workflows/merge-queue-ejection-notice.yml",
        ".github/workflows/registry-publish.yml"
      ]
    },
    "kinlab-ai/kin-vector": {
      "kind": "cargo_release",
      "workflow_paths": [
        ".github/workflows/registry-publish.yml",
        ".github/workflows/scheduled-failure-alarm.yml"
      ]
    },
    "kinlab-ai/kin-infer": {
      "kind": "cargo_release",
      "workflow_paths": [
        ".github/workflows/merge-queue-ejection-notice.yml",
        ".github/workflows/registry-publish.yml"
      ]
    },
    "kinlab-ai/kin-model": {
      "kind": "cargo_release",
      "workflow_paths": [
        ".github/workflows/kin-dependency-wave.yml",
        ".github/workflows/merge-queue-ejection-notice.yml",
        ".github/workflows/registry-publish.yml",
        ".github/workflows/release-recovery.yml"
      ]
    },
    "kinlab-ai/kin-db": {
      "kind": "cargo_release",
      "workflow_paths": [
        ".github/workflows/kin-dependency-wave.yml",
        ".github/workflows/registry-publish.yml",
        ".github/workflows/scheduled-failure-alarm.yml"
      ]
    },
    "kinlab-ai/kin-vfs": {
      "kind": "cargo_release",
      "workflow_paths": [
        ".github/workflows/kin-dependency-wave.yml",
        ".github/workflows/merge-queue-ejection-notice.yml",
        ".github/workflows/registry-publish.yml"
      ]
    },
    "kinlab-ai/kin-lsp": {
      "kind": "cargo_release",
      "workflow_paths": [
        ".github/workflows/kin-dependency-wave.yml",
        ".github/workflows/merge-queue-ejection-notice.yml",
        ".github/workflows/registry-publish.yml"
      ]
    },
    "kinlab-ai/kin-bench-spec": {
      "kind": "other",
      "workflow_paths": [
        ".github/workflows/merge-queue-ejection-notice.yml"
      ]
    },
    "kinlab-ai/kin-editor": {
      "kind": "other",
      "workflow_paths": [
        ".github/workflows/merge-queue-ejection-notice.yml"
      ]
    },
    "kinlab-ai/kin-infra": {
      "kind": "other",
      "workflow_paths": [
        ".github/workflows/ci.yml"
      ]
    },
    "kinlab-ai/homebrew-kin": {
      "kind": "other",
      "workflow_paths": [
        ".github/workflows/ci.yml"
      ]
    }
  }
}
